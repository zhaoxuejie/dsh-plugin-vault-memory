{
  "name": "dsh-plugin-vault-memory",
  "version": "0.3.0",
  "description": "让本地 Obsidian 知识库成为 DeepSeek Harness agent 的长期记忆与工作台（索引 + 检索工具 + 会话记忆注入 + 捕获 + GUI 浮卡）",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "keywords": ["dsh", "deepseek-harness", "obsidian", "vault", "knowledge-base", "second-brain"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "license": "MIT"
}
